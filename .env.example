# ========================================================
# Garmin & DeepSeek Harness Configuration for Hetzner Server
# ========================================================

# Database Type: 'mysql' (recommended for Hetzner) or 'sqlite'
DB_TYPE=mysql

# MySQL Connection Details
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=garmin_db
MYSQL_USER=garmin_user
MYSQL_PASSWORD=garmin_secure_password_here
MYSQL_ROOT_PASSWORD=root_secure_password_here

# SQLite Fallback Path (if DB_TYPE=sqlite)
SQLITE_DB_PATH=garmin_db/garmin.db

# Garmin Authentication (Token directory on server)
GARMIN_TOKEN_DIR=~/.garminconnect

# DeepSeek API Configuration (if using DeepSeek Harness)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
